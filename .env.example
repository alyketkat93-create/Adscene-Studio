# Database
DATABASE_URL="file:./dev.db"

# Storage Provider (local | s3)
STORAGE_DRIVER="local"

# AI Providers
# Default Vision Provider (gemini | openai | mock)
VISION_PROVIDER="gemini"
# Default Image Provider (gemini | openai | replicate | mock)
IMAGE_PROVIDER="gemini"

# API Keys (Server-side only, never leaked to client)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
REPLICATE_API_TOKEN=""

# Auth (optional, defaults to false)
ENABLE_AUTH="false"
